{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/Users/sartakov/.ohos/config/APP-CERT.cer",
          "keyAlias": "debugKey",
          "keyPassword": "***REDACTED***",
          "profile": "/Users/sartakov/.ohos/config/APP-PROFILE.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/Users/sartakov/.ohos/config/APP-KEYSTORE.p12",
          "storePassword": "***REDACTED***"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.0.1(21)",
        "compatibleSdkVersion": "6.0.1(21)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "default",
      "srcPath": "./products/default",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}